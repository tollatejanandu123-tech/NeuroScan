# NeuroVision AI - Environment Configuration

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# Deep Learning Device ('cpu' or 'cuda')
DEVICE=cpu

# File Upload Constraints
MAX_FILE_SIZE_MB=150
UPLOADS_DIR=./uploads

# Model Weights Configuration
MODELS_DIR=../models
CLASSIFIER_WEIGHTS_PATH=../models/classifier.pt
SEGMENTER_WEIGHTS_PATH=../models/segmenter.pt
LIGHTWEIGHT_WEIGHTS_PATH=../models/lightweight_segmenter.pt

# Clinical Review & Uncertainty Threshold Defaults
DEFAULT_MC_DROPOUT_PASSES=8
DEFAULT_UNCERTAINTY_THRESHOLD=0.35
DEFAULT_CONFIDENCE_THRESHOLD=0.75

# Quality Assessment Thresholds
QA_BLUR_THRESHOLD=40.0
QA_MIN_CONTRAST=18.0
QA_MAX_DISCONNECTED_COMPONENTS=6
